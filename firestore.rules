// firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection
    match /users/{userId} {
      // Users can read/write their own profile
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Admins can read all profiles
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      // Admins can write any profile
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Trades collection
    match /trades/{tradeId} {
      // Users can CRUD their own trades
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.uid;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
      // Admins can read all trades
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Import artifacts: unmatched closings / REPO legs kept for a future "rebuild journal" feature
    match /importArtifacts/{artifactId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.uid;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
    }

    // Radar: watchlist of tickers with a setup forming, before they become real trades
    match /radarItems/{itemId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.uid;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
    }

    // Бумажные сделки: их открывает и ведёт фоновый робот по радару, реальных денег они
    // не касаются. ОТДЕЛЬНАЯ коллекция — это и есть гарантия, что они физически не могут
    // попасть в Журнал, депозит, отчёт за месяц и корзины портфеля: все они читают только
    // trades и про эту коллекцию не знают.
    //
    // Робот ходит через firebase-admin и правила обходит по определению — эти правила
    // защищают браузер: один пользователь не должен видеть чужие бумажные сделки.
    match /paperTrades/{tradeId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.uid;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
    }
  }
}
